# Copy to .env (git-ignored) and adjust. Never commit .env.

# Number of simulated UEs. Start small (10); Phase 1 profiling measures 10/50/100.
PRAHARI_UE_COUNT=10

# First IMSI; UEs count up from here. Must stay inside test PLMN 001/01.
PRAHARI_IMSI_BASE=001010000000001

# Subscriber authentication keys (K and OPc, 32 hex chars each), shared by all test UEs.
# These defaults are the public UERANSIM/Open5GS example values, not secrets.
# Generate your own with:  openssl rand -hex 16
SUBSCRIBER_K=465B5CE8B199B49FAA5F0A2EE238A6BC
SUBSCRIBER_OPC=E8ED289DEBA952E4283B54E88E6183CA

# Seconds per capture file before tcpdump rotates to a new one.
CAPTURE_ROTATE_SECONDS=600

# Parallel compile jobs per image build (Open5GS, UERANSIM). 4 fits in 8 GB WSL2.
BUILD_JOBS=4

# HMAC-SHA256 key the probe uses to pseudonymise SUPIs (IMSIs) before they leave it.
# At least 16 bytes. Rotating it unlinks old and new pseudonyms. Leave empty and the
# probe drops SUPIs from events instead of hashing them.
# Generate with:  openssl rand -hex 32
PRAHARI_SUPI_KEY=
