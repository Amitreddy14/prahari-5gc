{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Amitreddy14/prahari-5gc/schemas/event.v1.schema.json",
  "title": "Prahari signalling event v1",
  "description": "One decoded control-plane message observed by the probe. Produced by the C++ probe, consumed by the Python analytics. One JSON object per Kafka record (topic prahari.events.v1).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "ts_ns",
    "interface",
    "protocol",
    "message",
    "message_code",
    "src",
    "dst",
    "size_bytes",
    "decode_status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "UUIDv4, unique per event"
    },
    "ts_ns": {
      "type": "integer",
      "minimum": 0,
      "description": "Capture timestamp, Unix epoch nanoseconds"
    },
    "interface": {
      "enum": [
        "N2",
        "N4",
        "SBI"
      ],
      "description": "3GPP reference point: N2 = gNB-AMF (NGAP over SCTP), N4 = SMF-UPF (PFCP over UDP 8805), SBI = NF-NF HTTP/2"
    },
    "protocol": {
      "enum": [
        "NGAP",
        "NAS-5GS",
        "PFCP",
        "HTTP2"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "description": "Human-readable message or procedure name, e.g. SessionEstablishmentRequest"
    },
    "message_code": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "description": "Numeric message type / procedure code from the protocol spec"
    },
    "direction": {
      "enum": [
        "request",
        "response",
        "indication",
        "unknown"
      ],
      "default": "unknown"
    },
    "src": {
      "$ref": "#/$defs/endpoint"
    },
    "dst": {
      "$ref": "#/$defs/endpoint"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "decode_status": {
      "enum": [
        "ok",
        "truncated",
        "bad_version",
        "bad_length",
        "unsupported",
        "malformed"
      ],
      "description": "Malformed traffic is still emitted: it is evidence, not noise"
    },
    "ue": {
      "type": "object",
      "additionalProperties": false,
      "description": "Correlation identifiers. Permanent identities are never emitted in clear.",
      "properties": {
        "ran_ue_ngap_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "amf_ue_ngap_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1099511627775
        },
        "supi_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$",
          "description": "First 64 bits of HMAC-SHA256(key, SUPI), hex"
        },
        "seid": {
          "type": "string",
          "pattern": "^[0-9]{1,20}$",
          "description": "PFCP SEID as decimal string (u64 is not JSON-number safe)"
        },
        "pdu_session_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16777215,
      "description": "PFCP sequence number or HTTP/2 stream id"
    },
    "cause": {
      "type": "string",
      "maxLength": 64
    },
    "sbi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "path": {
          "type": "string",
          "maxLength": 256,
          "description": "Path only; query strings are stripped"
        },
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "service": {
          "type": "string",
          "maxLength": 32,
          "description": "e.g. nnrf-disc, namf-comm, nsmf-pdusession"
        }
      }
    },
    "pfcp": {
      "type": "object",
      "additionalProperties": false,
      "description": "N4 session context resolved by the probe's session table. Present on PFCP events.",
      "properties": {
        "cp_seid": {
          "type": "string",
          "pattern": "^[0-9]{1,20}$",
          "description": "SEID allocated by the SMF (control plane), decimal"
        },
        "up_seid": {
          "type": "string",
          "pattern": "^[0-9]{1,20}$",
          "description": "SEID allocated by the UPF (user plane), decimal"
        },
        "session_state": {
          "enum": [
            "establishing",
            "active",
            "deleted",
            "unknown"
          ]
        },
        "session_known": {
          "type": "boolean",
          "description": "False if the message refers to a session the probe never saw created"
        },
        "node_id": {
          "type": "string",
          "maxLength": 255
        },
        "cause_code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "ie_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "pdr_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "far_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      }
    },
    "ngap": {
      "type": "object",
      "additionalProperties": false,
      "description": "N2 NGAP context. Present on NGAP events.",
      "properties": {
        "pdu_type": {
          "enum": [
            "initiating",
            "successful",
            "unsuccessful"
          ]
        },
        "procedure_code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "ie_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "gnb_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "From Global RAN Node ID (NG Setup)"
        },
        "gnb_id_bits": {
          "type": "integer",
          "minimum": 22,
          "maximum": 32
        },
        "plmn": {
          "type": "string",
          "pattern": "^[0-9]{5,6}$",
          "description": "MCC+MNC of the Global RAN Node ID"
        },
        "ran_node_name": {
          "type": "string",
          "maxLength": 150
        }
      }
    },
    "nas": {
      "type": "object",
      "additionalProperties": false,
      "description": "The NAS message carried in the NGAP NAS-PDU IE, if any. Never contains subscriber identity; SUPIs appear only as ue.supi_hash.",
      "properties": {
        "epd": {
          "enum": [
            "5GMM",
            "5GSM"
          ]
        },
        "security_header": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "integrity_protected": {
          "type": "boolean"
        },
        "ciphered": {
          "type": "boolean"
        },
        "decoded": {
          "type": "boolean",
          "description": "False when ciphered with a non-null or unknown algorithm"
        },
        "message_type": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "registration_type": {
          "enum": [
            "initial",
            "mobility",
            "periodic",
            "emergency",
            "other"
          ]
        },
        "identity_type": {
          "enum": [
            "none",
            "SUCI",
            "5G-GUTI",
            "IMEI",
            "5G-S-TMSI",
            "IMEISV",
            "other"
          ]
        },
        "suci_null_scheme": {
          "type": "boolean",
          "description": "True when the SUCI was not concealed (SUPI recoverable by any observer)"
        },
        "sm_message_type": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "sm_message": {
          "type": "string",
          "maxLength": 64
        },
        "selected_ciphering": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15,
          "description": "NEA algorithm chosen by Security Mode Command"
        },
        "selected_integrity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "mm_cause": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "description": "Ground truth, set only on testbed datasets by the attack injector. Never present in live mode.",
      "properties": {
        "is_attack": {
          "type": "boolean"
        },
        "attack_id": {
          "type": "string",
          "pattern": "^(N2|N4|SBI|UE)-[0-9]{2}$"
        },
        "run_id": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "is_attack"
      ]
    }
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ip",
        "port"
      ],
      "properties": {
        "ip": {
          "type": "string",
          "anyOf": [
            {
              "format": "ipv4"
            },
            {
              "format": "ipv6"
            }
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "nf": {
          "enum": [
            "gNB",
            "AMF",
            "SMF",
            "UPF",
            "NRF",
            "AUSF",
            "UDM",
            "UDR",
            "PCF",
            "NSSF",
            "BSF",
            "UE",
            "unknown"
          ]
        }
      }
    }
  }
}
